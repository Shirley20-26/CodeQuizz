#:import hex kivy.utils.get_color_from_hex

<PantallaResultado>:
    name: 'resultado'
    canvas.before:
        Color:
            rgba: 0.95,0.95,0.96,1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'
        padding: dp(24)
        spacing: dp(8)

        Label:
            text: root.titulo
            font_size: sp(30)
            bold: True
            color: hex('#FACC15')

        Label:
            text: root.detalle
            font_size: sp(20)

        Label:
            text: root.racha_texto
            font_size: sp(20)
            bold: True
            color: hex('#86EFAC')

        # Medalla dibujada (solo si el nivel está superado)
        MedallaIcono:
            color: root.color_medalla
            size: (dp(76), dp(76)) if root.hay_medalla else (0, 0)
            opacity: 1 if root.hay_medalla else 0
            pos_hint: {'center_x': 0.5}

        Label:
            text: root.texto_medalla if root.hay_medalla else ''
            bold: True
            font_size: sp(16)
            size_hint_y: None
            height: dp(26)

        Label:
            text: root.invitacion
            font_size: sp(16)
            color: hex('#E0E7FF')
            text_size: self.width, None
            halign: 'center'

        BotonPrincipal:
            text: 'Registrarme'
            height: dp(54) if root.es_invitado else 0
            opacity: 1 if root.es_invitado else 0
            disabled: not root.es_invitado
            on_release: root.ir_a_registro()

        BotonPrincipal:
            text: 'Siguiente nivel'
            height: dp(54) 
            opacity: 1 
            disabled: False

        BotonSecundario:
            text: 'Jugar otra vez'
            height: dp(46)
            on_release: root.jugar_otra_vez()

        BotonSecundario:
            text: 'Volver'
            height: dp(46)
            on_release: root.volver()